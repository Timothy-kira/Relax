        "tokenize": true,
        "tools": []
      }
    },
    "param": "chat_template_kwargs",
    "message": "chat_template_kwargs cannot set reserved keys: tokenize, tools"
  },
  "stop_not_strings": {
    "request": {
      "messages": [
        {
          "role": "user",
          "content": "hi"
        }
      ],
      "stop": [
        1
      ]
    },
    "param": "stop",
    "message": "stop must be a string or list of strings"
  },
  "tool_call_arguments_duplicate_keys": {
    "request": {
      "messages": [
        {
          "role": "user",
          "content": "hi"
        },
        {
          "role": "assistant",
          "content": "ok",
          "tool_calls": [
            {
              "id": "call_1",
              "type": "function",
              "function": {
                "name": "f",
                "arguments": "{\"a\": 1, \"a\": 2}"
              }
            }
          ]
        }
      ]
    },
    "param": "messages",
    "message": "messages[1].tool_calls[0].function.arguments contains duplicate key: a"
  },
  "tool_call_arguments_invalid_json": {
